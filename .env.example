# Host development values. Local credentials match the Compose defaults; change both together outside local development.
# Docker Compose overrides service hostnames for the app container.
DATABASE_URL=postgresql://portfoliocms:portfoliocms-dev@localhost:5432/portfoliocms
TEST_DATABASE_URL=postgresql://portfoliocms:portfoliocms-dev@localhost:5432/portfoliocms_test
APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-at-least-32-random-characters

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=portfoliocms
S3_ACCESS_KEY_ID=portfoliocms
S3_SECRET_ACCESS_KEY=portfoliocms-storage-dev
S3_FORCE_PATH_STYLE=true

MAX_UPLOAD_SIZE_MB=10
